# ---- Stage 1: сборка ----
FROM node:20-alpine AS builder

WORKDIR /app

# Копируем package files
COPY package*.json ./

# Устанавливаем зависимости
RUN npm ci

# Копируем исходный код
COPY . .

# Собираем приложение
RUN npm run build

# Проверяем что dist создана
RUN test -d dist || (echo "ERROR: dist directory not created!" && exit 1)

# ---- Stage 2: production image ----
FROM nginx:1.27-alpine

# Устанавливаем curl для healthcheck
RUN apk add --no-cache curl

# Копируем собранное приложение
COPY --from=builder --chown=nginx:nginx /app/dist /usr/share/nginx/html

# Копируем конфиг nginx для SPA
RUN cat > /etc/nginx/conf.d/default.conf <<'EOF'
server {
    listen 80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html index.htm;

    # Отключаем логирование для статики
    access_log off;
    error_log /var/log/nginx/error.log warn;

    # SPA configuration - все запросы идут в index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Кеширование для статических файлов
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header Pragma "public";
    }

    # Security Headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Предотвращаем кеширование index.html
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    # Запрещаем доступ к скрытым файлам
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
EOF

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
    