# Автоопределение текстовых файлов + нормализация к LF в репозитории
* text=auto

# Shell-скрипты — всегда LF (иначе entrypoint.sh упадёт в Linux-контейнере)
*.sh text eol=lf
entrypoint.sh text eol=lf

# Dockerfile — всегда LF
Dockerfile text eol=lf
Dockerfile* text eol=lf

# Конфиги
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.env text eol=lf
.env* text eol=lf

# Python — LF
*.py text eol=lf
*.txt text eol=lf

# JS/TS — LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Бинарные файлы — не трогать
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary