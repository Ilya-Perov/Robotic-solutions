FROM nginx:1.27-alpine

# Устанавливаем необходимые утилиты
RUN apk add --no-cache certbot curl bash

# Очищаем дефолтный конфиг
RUN rm -f /etc/nginx/conf.d/default.conf

# Создаем директории для логов и шаблонов конфигов
RUN mkdir -p /var/log/nginx /etc/nginx/templates-available

# Кладём оба конфига в отдельную папку — nginx их автоматически НЕ подхватит
COPY default.conf      /etc/nginx/templates-available/default.conf
COPY default.http.conf /etc/nginx/templates-available/default.http.conf

# Entrypoint, который выберет нужный конфиг при старте
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Healthcheck - проверяем что nginx отвечает
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:80 || exit 1

EXPOSE 80 443

ENTRYPOINT ["/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]